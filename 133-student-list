public void insertStudents(List<String> studentNames, List<String> studentEmails) {
    // code here
    if(studentNames.size()>=0){
        
        List<apxio__Student__c> apxStuList = new List<apxio__Student__c>();
        for(integer i=0; i< studentNames.size() ;i++){
            apxio__Student__c apxStu =new apxio__Student__c();
            apxStu.Name = studentNames[i];
            apxStu.apxio__Email__c  = studentEmails[i];
            apxStuList.add(apxStu);
        }
        if(!apxStuList.isEmpty())
            insert apxStuList;
    }
}