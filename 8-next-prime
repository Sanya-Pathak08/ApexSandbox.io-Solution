public Integer nextPrime(Integer num) {
    //code here
    
    Boolean isPrime=false;
    Integer prime;
    if(num < 2){
        return 2;
    }
    for(Integer i = num+1; i>num ;i++){
        for(integer j=2; j<i ;j++){
            if(math.mod(i,j) ==0){
                isPrime =false;
                break; 
            }else{
                isPrime =true;
            }
        }
        if(isPrime == true){
            prime =i;
            break;
        }
       
    }
    return prime;
}