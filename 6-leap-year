public Boolean isLeapYear(Integer year) {
    //code here
    if(Math.mod(year,4) == 0 ){
        boolean leap_yr =true;
        if(Math.mod(year,100) == 0){
            if(Math.mod(year,400)==0)
                 leap_yr=true;
            else
                leap_yr =false;
        }
    }
    else{
        leap_yr =false;
    }
    if(leap_yr == true){
        return true;

    }
    else {
        return false;
    }
}
