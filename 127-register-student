public String registerStudent(String name, String phone, String email) {
    // code here
    apxio__Student__c  apxStu =new apxio__Student__c();
    apxStu.Name = name;
    apxStu.apxio__Phone__c = phone;
    apxStu.apxio__Email__c = email;
    insert apxStu;
    apxio__Student__c stu = [SELECT Id, apxio__Registration_Number__c FROM  apxio__Student__c where id =: apxStu.Id];
    return stu.apxio__Registration_Number__c;
}