public List<apxio__Student__c> selectStudentsWithoutContactInfo() {
    // code here
    List<apxio__Student__c> apxStu =new List<apxio__Student__c>();
    apxStu = [SELECT Id, Name, apxio__Email__c, apxio__Phone__c, apxio__Registration_Number__c,apxio__Active__c
                 FROM apxio__Student__c 
                 WHERE apxio__Active__c =true AND (apxio__Phone__c = null OR apxio__Phone__c = ' ' OR apxio__Email__c = null OR  apxio__Email__c = ' ') ORDER By Name];
    return  apxstu;
}